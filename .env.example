DATABASE_URL=sqlite:///./prism.db
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auto-bootstrap on startup when no institution exists (fresh prism.db)
AUTO_BOOTSTRAP=true
BOOTSTRAP_INST_CODE=BRIGHTPATH
BOOTSTRAP_INST_NAME=BrightPath Academy
BOOTSTRAP_ADMIN_EMAIL=rajesh@brightpath.edu
BOOTSTRAP_TUTOR_EMAIL=priya@brightpath.edu
BOOTSTRAP_STUDENT_EMAIL=arjun@brightpath.edu

# Vertex AI (Gemini 2.5 Flash — reports + terminal chat)
VERTEX_ENABLED=true
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_SUMMARY_CACHE_TTL=300
