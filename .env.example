# Postgres multi-schema tenancy (Swotify-style). SQLite uses single-schema dev mode.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/prism
DATABASE_URL=sqlite:///./prism.db
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Idempotent demo seed — on by default (set SEED_DEMO=false in production).
SEED_DEMO=true

# =============================================================================
# SEED CREDENTIALS (when SEED_DEMO=true — dev/local only)
# Login needs: organization code + email + password
# =============================================================================
#
# Platform super user
#   Org code : SYSTEM
#   Email    : superuser@prism.io
#   Password : superuser123
#   Console  : /admin/platform
#
# Demo organization DEMO001
#   Org code : DEMO001
#   Admin    : admin@demo.com / demo1234
#   Tutor    : tutor@demo.com / demo1234
#   Student  : student@demo.com / demo1234
#
# NEW users created in admin UI (not seed):
#   Email    : {phone digits}@gmail.com  (e.g. 9876543210@gmail.com)
#   Password : phone number (default) or custom password set at creation
#
# Full setup guide: ../README.md
# =============================================================================

# Legacy auto-bootstrap (SQLite dev). Prefer SEED_DEMO on Postgres/Docker.
AUTO_BOOTSTRAP=false

# Default org code pre-filled on /setup (organization owner first-run).
DEFAULT_ORGANIZATION_CODE=CSC

# Vertex AI (Gemini — reports + terminal chat)
VERTEX_ENABLED=true
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_SUMMARY_CACHE_TTL=300
VERTEX_BOOK_TIMEOUT_SECONDS=180
VERTEX_TOPIC_MAP_TIMEOUT_SECONDS=90
# Optional Gemini Developer API key (works in Docker without gcloud ADC)
# GEMINI_API_KEY=
# Docker: host path to application_default_credentials.json
# Windows: C:/Users/YOU/AppData/Roaming/gcloud/application_default_credentials.json
# macOS/Linux: /home/YOU/.config/gcloud/application_default_credentials.json
# HOST_GCP_CREDENTIALS=
