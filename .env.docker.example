# Copy to .env.docker and adjust, then:
#   docker compose -f docker-compose.backend.yml --env-file .env.docker up -d --build
#
# Full setup guide: README.md and docs/DOCKER_BACKEND.md

SEED_DEMO=true

POSTGRES_USER=prism
POSTGRES_PASSWORD=prism123
POSTGRES_DB=prism
POSTGRES_PORT=5432

BACKEND_PORT=8002
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEFAULT_ORGANIZATION_CODE=CSC

# Must include your local Vite dev server origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Vertex AI (book outlines + reports). ADC from:
#   gcloud auth application-default login
# Windows:
# HOST_GCP_CREDENTIALS=C:/Users/YOU/AppData/Roaming/gcloud/application_default_credentials.json
# macOS/Linux:
# HOST_GCP_CREDENTIALS=/home/YOU/.config/gcloud/application_default_credentials.json
VERTEX_ENABLED=true
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
# Optional instead of ADC:
# GEMINI_API_KEY=

# =============================================================================
# SEED CREDENTIALS (SEED_DEMO=true)
# =============================================================================
# SYSTEM  | superuser@prism.io | superuser123
# DEMO001 | admin@demo.com     | demo1234  (org owner)
# DEMO001 | tutor@demo.com     | demo1234
# DEMO001 | student@demo.com   | demo1234
#
# Admin-created users: {phone}@gmail.com / password = phone (default)
# Reset DB: docker compose -f docker-compose.backend.yml down -v
# =============================================================================
