# Copy to .env.docker and adjust, then:
#   docker compose -f docker-compose.backend.yml --env-file .env.docker up -d --build
#
# Full setup guide: README.md and docs/DOCKER_BACKEND.md

SEED_DEMO=true

POSTGRES_USER=prism
POSTGRES_PASSWORD=prism123
POSTGRES_DB=prism
POSTGRES_PORT=5432

BACKEND_PORT=8002
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEFAULT_ORGANIZATION_CODE=CSC

# Must include your local Vite dev server origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# =============================================================================
